# ============================================================
# SokPlus - Variables d'environnement
# Copier vers .env et remplir les valeurs
# ============================================================

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Base de données PostgreSQL
DATABASE_URL=postgresql://sokplus_user:sokplus_password@localhost:5432/sokplus_db

# JWT Authentication
JWT_SECRET=sokplus_jwt_secret_change_in_production_minimum_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=sokplus_refresh_secret_change_in_production_minimum_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (pour sessions, cache, rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sokplus_redis_password
REDIS_DB=0

# Upload fichiers
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Email (SMTP - ex: Gmail, Brevo, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@sokplus.dz
SMTP_PASS=your_smtp_password
SMTP_FROM="SokPlus <noreply@sokplus.dz>"

# Rate Limiting
THROTTLE_TTL=900
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5

# PDF & QR
PDF_STORAGE_PATH=./storage/invoices
QR_CODE_SIZE=200

# Fiscal Algérien
TVA_STANDARD=19
TVA_REDUIT=9
TIMBRE_FISCAL=50

# Logs
LOG_LEVEL=debug
LOG_FILE=./logs/sokplus.log

# Sécurité
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
BCRYPT_ROUNDS=12
